APP_NAME=ArchiDoc
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Base de données ---
# En local / test : sqlite
# En production (VPS) : pgsql
DB_CONNECTION=sqlite
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=archidoc
# DB_USERNAME=archidoc_user
# DB_PASSWORD=secret

# --- Sessions & Cache ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- Configuration Messagerie (SMTP / Queue) ---
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=votre.email@gmail.com
MAIL_PASSWORD=votre_mot_de_passe_application
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="votre.email@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Informations Développeur (Footer & Crédits) ---
DEV_NAME="MOAFO GAÜS"
DEV_ADR="https://moafogaus.abndns.com"

# --- Automate de Simulation d'Activité Démo (Arrière-plan) ---
# Active la génération automatique et continue de consultations et téléchargements réalistes
DEMO_SIMULATION_ENABLED=false
DEMO_SIMULATION_MIN=5
DEMO_SIMULATION_MAX=15
DEMO_SIMULATION_START_HOUR=8
DEMO_SIMULATION_END_HOUR=18
DEMO_SIMULATION_WEEKDAYS_ONLY=true

# --- Frontend & Assets ---
VITE_APP_NAME="${APP_NAME}"
